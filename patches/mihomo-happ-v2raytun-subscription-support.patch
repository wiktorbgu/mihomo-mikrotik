+// hpwnrFallback fetches and converts a subscription only after Mihomo's native
+// path failed. hpwnr's stdout mode returns the complete converted response.
+func (h *HTTPVehicle) hpwnrFallback(parent context.Context, cause error) ([]byte, error) {
+	binary, lookErr := exec.LookPath("hpwnr")
+	if lookErr != nil {
+		return nil, fmt.Errorf("hpwnr unavailable: %w", lookErr)
+	}
+	ctx, cancel := context.WithTimeout(parent, h.timeout)
+	defer cancel()
+
+	args := []string{h.url}
+	for key, values := range h.header {
+		for _, value := range values {
+			args = append(args, "header", key, value)
+		}
+	}
+	args = append(args, "uri", "stdout")
+	cmd := exec.CommandContext(ctx, binary, args...)
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	out, runErr := cmd.Output()
+	stderrText := bytes.TrimSpace(stderr.Bytes())
+	if len(stderrText) > 2048 {
+		stderrText = stderrText[:2048]
+	}
+	if runErr != nil {
+		if len(stderrText) > 0 {
+			return nil, fmt.Errorf("hpwnr failed after %v: %w; stderr: %s", cause, runErr, stderrText)
+		}
+		return nil, fmt.Errorf("hpwnr failed after %v: %w", cause, runErr)
+	}
+	out = bytes.TrimSpace(out)
+	if len(out) == 0 {
+		if len(stderrText) > 0 {
+			return nil, fmt.Errorf("hpwnr returned empty stdout after %v; stderr: %s", cause, stderrText)
+		}
+		return nil, fmt.Errorf("hpwnr returned empty stdout after %v", cause)
+	}
+	return out, nil
+}
+
+// Fallback implements the parser-error fallback used by Fetcher.
+func (h *HTTPVehicle) Fallback(cause error) ([]byte, error) {
+	return h.hpwnrFallback(context.Background(), cause)
+}
