index 1514310..e0543ac 100644
--- a/context/dns.go
+++ b/context/dns.go
@@ -2,6 +2,7 @@ package context
 
 import (
 	"context"
+	"net/netip"
 
 	"github.com/metacubex/mihomo/common/utils"
 
@@ -43,3 +44,17 @@ func (c *DNSContext) SetType(tp string) {
 func (c *DNSContext) Type() string {
 	return c.tp
 }
+
+// dnsSrcAddrKey stores the remote address of a DNS client.
+type dnsSrcAddrKey struct{}
+
+// WithDNSSrcAddr returns a context carrying the DNS client's source address.
+func WithDNSSrcAddr(ctx context.Context, addr netip.Addr) context.Context {
+	return context.WithValue(ctx, dnsSrcAddrKey{}, addr)
+}
+
+// DNSSrcAddrFrom returns the DNS client's source address, if available.
+func DNSSrcAddrFrom(ctx context.Context) netip.Addr {
+	addr, _ := ctx.Value(dnsSrcAddrKey{}).(netip.Addr)
+	return addr
+}
